#!/usr/bin/env python
"""Check the PromQL expression used by the DM professional dashboard panel."""

import json
import sys


EXPECTED_EXPR = (
    'clamp_min(dm_syncer_binlog_file{k8s_cluster=~"$k8s_cluster",tidb_cluster=~"$tidb_cluster", '
    'job_id=~"$job_id",source_id=~"$source", task=~"$task", node="master"} - '
    'ON(task,source_id) dm_syncer_binlog_file{k8s_cluster=~"$k8s_cluster",tidb_cluster=~"$tidb_cluster", '
    'job_id=~"$job_id",source_id=~"$source", task=~"$task", node="syncer"}, 0)'
)


def yield_panels(container):
    for panel in container.get("panels", []):
        yield panel
        for nested_panel in yield_panels(panel):
            yield nested_panel


def main():
    if len(sys.argv) != 2:
        raise RuntimeError("usage: check_grafana_dashboard_promql DASHBOARD_JSON")

    with open(sys.argv[1], "r") as dashboard_file:
        dashboard = json.load(dashboard_file)

    panels = [panel for panel in yield_panels(dashboard) if panel.get("id") == 43]
    if len(panels) != 1:
        raise RuntimeError(
            "expected exactly one panel with id 43, found {0}".format(len(panels))
        )

    targets = [target for target in panels[0].get("targets", []) if target.get("refId") == "B"]
    if len(targets) != 1:
        raise RuntimeError(
            "expected exactly one target with refId B in panel id 43, found {0}".format(
                len(targets)
            )
        )

    expression = targets[0].get("expr")
    if expression != EXPECTED_EXPR:
        raise RuntimeError(
            "panel id 43 target refId B has unexpected PromQL expression; "
            "expected {0!r}, found {1!r}".format(EXPECTED_EXPR, expression)
        )


if __name__ == "__main__":
    main()
